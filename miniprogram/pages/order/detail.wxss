.order-detail__scroll {
  height: calc(100vh - 46px - 200rpx);
}

@import '../../styles/pay.wxss';

.order-detail__content {
  padding: 24rpx 32rpx;
}

.pay-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.card__title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.order-detail__actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: var(--color-surface);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}
