<view class="page triage-result">
  <page-nav title="就医导航" />
  <scroll-view class="triage-result__scroll" scroll-y>
    <view class="triage-result__content">
      <view class="triage-result__summary card">
        <text class="triage-result__label">{{ conclusion }}</text>
        <text class="triage-result__advice">{{ advice }}</text>
        <van-button wx:if="{{ urgent }}" type="danger" size="small" bind:click="callHelp">拨打 120</van-button>
        <van-button wx:elif="{{ helpPhone }}" plain type="primary" size="small" bind:click="callHelp">联系导诊台</van-button>
        <text wx:elif="{{ !departments.length }}" class="triage-result__advice">可到门诊服务台咨询。</text>
      </view>
      <triage-result-card
        wx:for="{{ departments }}"
        wx:key="id"
        department="{{ item }}"
        rank="{{ index + 1 }}"
        bind:select="onDeptSelect"
      />
    </view>
  </scroll-view>
  <view wx:if="{{ departments.length }}" class="triage-result__footer safe-bottom">
    <van-button type="primary" block round custom-class="btn-primary" bind:click="onViewAll">查看首选科室医生</van-button>
  </view>
</view>
