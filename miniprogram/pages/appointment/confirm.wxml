<view class="page page--bottom-bar confirm">
  <page-nav title="预约挂号" />
  <scroll-view class="confirm__scroll" scroll-y>
    <view class="confirm__content">
      <doctor-header doctor="{{ doctor }}" />
      <view class="card card--flat confirm__info">
        <view class="confirm__row">
          <text class="confirm__label">就诊时间</text>
          <text class="confirm__value confirm__value--primary">{{ timeText }}</text>
        </view>
        <view class="confirm__row">
          <text class="confirm__label">挂号费用</text>
          <text class="confirm__value confirm__value--fee">{{ feeText }}</text>
        </view>
      </view>
      <view class="card card--flat">
        <picker wx:if="{{ profileChoices.length }}" range="{{ profileChoices }}" range-key="label"
          value="{{ profileIndex }}" bindchange="onProfileChange">
          <van-cell title="常用就诊人" value="{{ profileChoices[profileIndex].label }}" is-link />
        </picker>
        <van-cell title="管理常用就诊人" is-link bind:click="managePatients" />
        <block wx:if="{{ !patientProfileId }}">
        <van-field label="就诊人" maxlength="50" value="{{ patientName }}" placeholder="请输入就诊人姓名" bind:change="onPatientNameInput" />
        <van-field label="联系电话" value="{{ patientPhone }}" type="number" maxlength="11" placeholder="请输入手机号" bind:change="onPatientPhoneInput" />
        </block>
      </view>
      <view class="card">
        <text class="confirm__label">备注</text>
        <van-field
          value="{{ remark }}"
          type="textarea"
          maxlength="200"
          placeholder="请输入备注（选填）"
          autosize
          border="{{ false }}"
          bind:change="onRemarkInput"
        />
      </view>
      <view class="card">
        <view class="card__title">支付方式</view>
        <view
          class="pay-item {{ payMethod === item.id ? 'pay-item--active' : '' }}"
          wx:for="{{ payMethods }}"
          wx:key="id"
          data-id="{{ item.id }}"
          bindtap="onPayMethodTap"
        >
          <view class="pay-item__left">
            <view class="pay-item__icon pay-item__icon--{{ item.id }}">{{ item.id === 'wechat' ? '微' : (item.id === 'alipay' ? '支' : '余') }}</view>
            <view>
              <text class="pay-item__name">{{ item.name }}</text>
              <text wx:if="{{ item.desc }}" class="pay-item__desc">{{ item.desc }}</text>
            </view>
          </view>
          <view class="pay-item__radio {{ payMethod === item.id ? 'pay-item__radio--on' : '' }}"></view>
        </view>
      </view>
    </view>
  </scroll-view>
  <bottom-bar text="提交并支付" price="{{ feeText }}" bind:confirm="onConfirm" />
</view>

<pay-drawer
  wx:if="{{ payDrawerVisible }}"
  show="{{ payDrawerVisible }}"
  method="{{ payDrawerMethod }}"
  amount="{{ feeAmount }}"
  balance="{{ balance }}"
  loading="{{ submitting }}"
  bind:close="onPayDrawerClose"
  bind:confirm="onPayDrawerConfirm"
/>
