.mine {
  padding: 0 32rpx;
}

.mine__profile,
.mine__hero {
  margin-top: 24rpx;
  margin-bottom: var(--spacing-md);
  border-radius: var(--radius-lg);
  background: var(--color-primary-light);
  border: 1rpx solid rgba(0, 184, 148, 0.12);
  box-shadow: var(--shadow-card);
}

.mine__profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
}

.mine__hero {
  padding: 32rpx;
}

.mine__hero-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.mine__hero-text {
  flex: 1;
  min-width: 0;
}

.mine__hero-title {
  display: block;
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.mine__hero-desc {
  display: block;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.mine__avatar {
  border-radius: 50%;
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.mine__avatar--lg {
  width: 112rpx;
  height: 112rpx;
}

.mine__avatar--hero {
  width: 120rpx;
  height: 120rpx;
}

.mine__avatar-img {
  width: 100%;
  height: 100%;
}

.mine__avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  flex-shrink: 0;
}

.mine__avatar-btn::after {
  border: none;
}

.mine__info {
  flex: 1;
  min-width: 0;
}

.mine__name {
  display: block;
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.mine__name-input,
.mine__nickname-input {
  display: block;
  width: 100%;
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
  padding: 0;
  background: transparent;
}

.mine__nickname-input {
  margin-bottom: 12rpx;
}

.mine__meta {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.mine__logout {
  flex-shrink: 0;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
}

.mine__wx-btn {
  background: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
}

.mine__web-login {
  margin: 20rpx 0;
  padding: 28rpx 32rpx;
}

.mine__web-login-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--color-text);
}

.mine__web-account {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  word-break: break-all;
}

.mine__copy {
  flex-shrink: 0;
  color: var(--color-primary);
}

.mine__web-password {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  font-size: var(--font-body);
}

.mine__menu {
  padding: 8rpx 32rpx;
}

.mine__menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.mine__menu-item:last-child {
  border-bottom: none;
}

.mine__menu-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine__menu-title {
  flex: 1;
  font-size: var(--font-body);
  color: var(--color-text);
}

.mine__badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  margin-right: 8rpx;
  border-radius: 16rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}
